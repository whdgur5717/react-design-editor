{
	"name": "@open-editor-sdk/core",
	"version": "0.0.1",
	"private": false,
	"repository": {
		"type": "git",
		"url": "https://github.com/whdgur5717/react-design-editor.git",
		"directory": "packages/editor-core"
	},
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"files": [
