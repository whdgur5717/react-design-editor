			".": {
				"types": "./dist/index.d.ts",
				"import": "./dist/index.js"
			}
		}
	},
	"scripts": {
		"build": "tsdown",
		"lint": "eslint --fix",
		"type-check": "tsgo --noEmit"
	},
	"dependencies": {
		"@tiptap/core": "^3.18.0",
		"csstype": "^3.2.3",
		"zod": "^4.0.0"
	},
	"devDependencies": {
		"@open-editor-sdk/eslint-config": "workspace:*",
		"@open-editor-sdk/tsconfig": "workspace:*"
	}
