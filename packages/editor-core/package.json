				"types": "./dist/index.d.ts",
				"import": "./dist/index.js"
			}
		}
	},
	"scripts": {
		"build": "tsdown",
		"lint": "eslint --fix",
		"type-check": "tsgo --noEmit"
	},
	"dependencies": {
		"@tiptap/core": "^3.18.0",
		"csstype": "^3.2.3",
		"zod": "^3.24.0"
	},
	"devDependencies": {
		"@design-editor/eslint-config": "workspace:*",
		"@design-editor/tsconfig": "workspace:*"
