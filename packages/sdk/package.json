{
	"name": "open-editor-sdk",
	"version": "0.0.1",
	"private": false,
	"repository": {
		"type": "git",
		"url": "https://github.com/whdgur5717/react-design-editor.git",
		"directory": "packages/sdk"
	},
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"files": [
		"dist"
	],
	"sideEffects": [
		"**/*.css"
	],
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./createEditor": {
			"types": "./src/createEditor/index.tsx",
			"import": "./src/createEditor/index.tsx"
		},
		"./EditorProvider": {
			"types": "./src/EditorProvider/index.tsx",
			"import": "./src/EditorProvider/index.tsx"
		},
		"./EditorRoot": {
			"types": "./src/EditorRoot/index.tsx",
			"import": "./src/EditorRoot/index.tsx"
		},
		"./styles.css": "./src/styles/index.css",
		"./EditorCanvas": {
			"types": "./src/EditorCanvas/index.tsx",
			"import": "./src/EditorCanvas/index.tsx"
		},
		"./Toolbar": {
			"types": "./src/Toolbar/index.tsx",
			"import": "./src/Toolbar/index.tsx"
		},
		"./LayersPanel": {
			"types": "./src/LayersPanel/index.tsx",
			"import": "./src/LayersPanel/index.tsx"
		},
		"./PropertiesPanel": {
			"types": "./src/PropertiesPanel/index.tsx",
			"import": "./src/PropertiesPanel/index.tsx"
		},
		"./useEditor": {
			"types": "./src/useEditor/index.tsx",
			"import": "./src/useEditor/index.tsx"
		}
	},
	"publishConfig": {
		"access": "public",
		"main": "./dist/index.js",
		"types": "./dist/index.d.ts",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"import": "./dist/index.js"
			},
			"./createEditor": {
				"types": "./dist/createEditor.d.ts",
				"import": "./dist/createEditor.js"
			},
			"./EditorProvider": {
				"types": "./dist/EditorProvider.d.ts",
				"import": "./dist/EditorProvider.js"
			},
			"./EditorRoot": {
				"types": "./dist/EditorRoot.d.ts",
				"import": "./dist/EditorRoot.js"
			},
			"./styles.css": "./dist/style.css",
			"./EditorCanvas": {
				"types": "./dist/EditorCanvas.d.ts",
				"import": "./dist/EditorCanvas.js"
			},
			"./Toolbar": {
				"types": "./dist/Toolbar.d.ts",
				"import": "./dist/Toolbar.js"
			},
			"./LayersPanel": {
				"types": "./dist/LayersPanel.d.ts",
				"import": "./dist/LayersPanel.js"
			},
			"./PropertiesPanel": {
				"types": "./dist/PropertiesPanel.d.ts",
				"import": "./dist/PropertiesPanel.js"
			},
			"./useEditor": {
				"types": "./dist/useEditor.d.ts",
				"import": "./dist/useEditor.js"
			}
		}
	},
	"scripts": {
		"build": "tsdown",
		"prepack": "pnpm build",
		"lint": "eslint --fix",
		"type-check": "tsgo --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@open-editor-sdk/canvas": "workspace:*",
		"@open-editor-sdk/components": "workspace:*",
		"@open-editor-sdk/core": "workspace:*",
		"@open-editor-sdk/shell": "workspace:*"
	},
	"peerDependencies": {
		"react": ">=18.0.0 <20.0.0",
		"react-dom": ">=18.0.0 <20.0.0"
	},
	"devDependencies": {
		"@open-editor-sdk/eslint-config": "workspace:*",
		"@open-editor-sdk/tsconfig": "workspace:*",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@vitejs/plugin-react": "^4.3.0",
		"eslint-plugin-react": "^7.37.5",
		"vite": "^6.0.0"
	}
}
