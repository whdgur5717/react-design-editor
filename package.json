{
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.28.0",
	"scripts": {
		"dev": "pnpm --filter @open-editor-sdk/shell --filter @open-editor-sdk/canvas --parallel run dev",
		"format": "prettier --write .",
		"lint": "pnpm -r --parallel run lint -- .",
		"type-check": "pnpm -r --parallel run type-check",
		"prepare": "husky",
		"build": "pnpm --filter @open-editor-sdk/core --filter @open-editor-sdk/components --filter @open-editor-sdk/shell --filter @open-editor-sdk/canvas --filter open-editor-sdk build",
		"build:shell": "pnpm --filter @open-editor-sdk/shell build",
		"build:canvas": "pnpm --filter @open-editor-sdk/canvas build",
		"test": "vitest",
		"test:unit": "vitest run",
		"test:e2e": "playwright test",
		"release:version": "changeset version && pnpm install --lockfile-only --ignore-scripts",
		"release:publish": "pnpm build && changeset publish",
		"verify:publish-sdk": "node scripts/verify-sdk-publish.mjs"
	},
	"devDependencies": {
		"@actions/core": "^1.11.1",
		"@actions/github": "^6.0.0",
		"@changesets/cli": "^3.0.1",
		"@playwright/test": "^1.51",
		"@tsdown/css": "^0.21.10",
		"@types/node": "^25.0.10",
		"@typescript/native-preview": "^7.0.0-dev.20260124.1",
		"@vitest/browser-playwright": "^4.0.18",
		"concurrently": "^9.2.1",
		"eslint": "^9.39.2",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.7",
		"minimatch": "^10.0.1",
		"prettier": "latest",
		"tsdown": "^0.21.10",
		"typescript": "~5.6.2",
		"vitest": "^4.0.18",
		"vitest-browser-react": "^2.2.0"
	}
}
